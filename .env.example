# Copy to .env. Every value is optional; the build scripts read this file if it exists.

# GitHub token with read:packages, needed by `pnpm install` for @northlight-systems/cloud-ui
# (GitHub Packages). Set it in your shell instead if you prefer: export NODE_AUTH_TOKEN="$(gh auth token)".
NODE_AUTH_TOKEN=

# The identity `pnpm package` signs the installed app with (`security find-identity -v -p codesigning`).
# A stable identity lets each rebuilt app read its Keychain key without asking again. Empty or "-"
# signs ad hoc, which works, but macOS may ask for Keychain access after each rebuild.
CODESIGN_IDENTITY=
